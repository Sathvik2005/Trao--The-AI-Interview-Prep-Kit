NODE_ENV=development
PORT=3000
# Optional for local development. Leave empty for the in-memory store, or use a MongoDB Atlas URI for persistence.
MONGODB_URI=
MONGODB_DATABASE=interview_prep_kit
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=
TEST_EMAIL=demo@interview-prep.local
TEST_PASSWORD=DemoPassword123!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Optional: override DNS resolvers when a local network blocks MongoDB SRV lookups
DNS_SERVERS=
